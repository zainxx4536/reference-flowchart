{
  "name": "reference-flowchart",
  "version": "0.2.0",
  "private": true,
  "description": "Source-backed Chinese flowcharts with PNG and native editable Visio output",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check:env": "node scripts/check_env.cjs",
    "demo": "node scripts/flowchart.cjs demo",
    "example:paper": "node scripts/flowchart.cjs paper",
    "test": "node scripts/run_tests.cjs",
    "test:unit": "node scripts/run_tests.cjs --no-browser",
    "export:visio": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/export_visio.ps1",
    "test:visio": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tests/visio.integration.ps1"
  },
  "dependencies": {
    "playwright": "1.62.1"
  }
}
