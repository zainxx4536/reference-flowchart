{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reference Flowchart layout",
  "type": "object",
  "required": [
    "canvas",
    "nodes"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "canvas": {
      "type": "object",
      "properties": {
        "width": {
          "type": "number",
          "minimum": 100,
          "maximum": 20000
        },
        "height": {
          "type": "number",
          "minimum": 100,
          "maximum": 20000
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string",
          "minLength": 1
        },
        "title_y": {
          "type": "number",
          "minimum": 0,
          "maximum": 20000
        },
        "subtitle_y": {
          "type": "number",
          "minimum": 0,
          "maximum": 20000
        },
        "title_size": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 240
        },
        "subtitle_size": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 240
        },
        "font_size": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 240
        },
        "font_family": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      },
      "minItems": 1
    },
    "zones": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/zone"
      },
      "minItems": 0
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      },
      "minItems": 0
    },
    "junctions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "parent": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 20000
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 20000
          },
          "radius": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 30
          }
        },
        "required": [
          "id",
          "x",
          "y"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 20000
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 20000
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "font_size": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 240
          },
          "bold": {
            "type": "boolean"
          },
          "anchor": {
            "type": "string",
            "enum": [
              "start",
              "middle",
              "end"
            ]
          }
        },
        "required": [
          "x",
          "y",
          "text"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            },
            "minItems": 1
          }
        },
        "required": [
          "name",
          "nodes"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "layout": {
      "type": "object",
      "properties": {
        "align": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "nodes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
                },
                "minItems": 2,
                "uniqueItems": true
              },
              "axis": {
                "type": "string",
                "enum": [
                  "x",
                  "y"
                ]
              },
              "anchor": {
                "type": "string",
                "enum": [
                  "start",
                  "center",
                  "end"
                ]
              },
              "value": {
                "type": "number",
                "minimum": 0,
                "maximum": 20000
              }
            },
            "required": [
              "nodes",
              "axis"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "distribute": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "nodes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
                },
                "minItems": 2,
                "uniqueItems": true
              },
              "axis": {
                "type": "string",
                "enum": [
                  "x",
                  "y"
                ]
              },
              "gap": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000
              }
            },
            "required": [
              "nodes",
              "axis",
              "gap"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "paper",
            "code",
            "design"
          ]
        },
        "document": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "section": {
          "type": "string",
          "minLength": 1
        },
        "figure": {
          "type": "string",
          "minLength": 1
        },
        "equation": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "document"
      ],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "parent": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 20000
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 20000
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 20000
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 20000
        },
        "font_size": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 240
        },
        "line_height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 480
        },
        "shape": {
          "type": "string",
          "enum": [
            "rect",
            "cylinder",
            "diamond",
            "terminator"
          ]
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "ellipse_radius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 500
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "x",
        "y",
        "width",
        "height",
        "lines"
      ],
      "additionalProperties": false
    },
    "zone": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "parent": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 20000
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 20000
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 20000
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 20000
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "title_y": {
          "type": "number",
          "minimum": 0,
          "maximum": 20000
        },
        "font_size": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 240
        }
      },
      "required": [
        "id",
        "x",
        "y",
        "width",
        "height",
        "title"
      ],
      "additionalProperties": false
    },
    "point": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 20000
      },
      "minItems": 2,
      "maxItems": 2
    },
    "route": {
      "type": "object",
      "properties": {
        "from_port": {
          "type": "string",
          "enum": [
            "auto",
            "left",
            "right",
            "top",
            "bottom"
          ]
        },
        "to_port": {
          "type": "string",
          "enum": [
            "auto",
            "left",
            "right",
            "top",
            "bottom"
          ]
        },
        "clearance": {
          "type": "number",
          "minimum": 4,
          "maximum": 200
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "from": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "to": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point"
          },
          "minItems": 2
        },
        "route": {
          "$ref": "#/$defs/route"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "arrow": {
          "type": "boolean"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "from",
        "to"
      ],
      "additionalProperties": false
    }
  }
}
